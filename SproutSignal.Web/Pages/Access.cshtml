@page
@model SproutSignal.Web.Pages.AccessModel
@{
    ViewData["Title"] = "Your plants";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5 text-center">
                <h1 class="h2 mb-3">Welcome to your garden</h1>
                <p class="text-muted mb-4">
                    Sign in to keep your plants across visits, or continue as a guest to try SproutSignal now.
                </p>

                <div class="d-grid gap-3">
                    <a class="btn btn-success btn-lg"
                       asp-area="Identity"
                       asp-page="/Account/Login"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Login
                    </a>

                    <form method="post" asp-page="/Guest" class="d-grid">
                        <button type="submit" class="btn btn-outline-success btn-lg">
                            Continue as guest
                        </button>
                    </form>

                    <a class="btn btn-link text-dark"
                       asp-area="Identity"
                       asp-page="/Account/Register"
                       asp-route-returnUrl="@Model.ReturnUrl">
                        Create an account
                    </a>
                </div>

                <p class="small text-muted mt-4 mb-0">
                    Guest data is available only while your guest session remains active.
                </p>
            </div>
        </div>
    </div>
</div>
