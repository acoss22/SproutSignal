@page
@model SproutSignal.Web.Pages.Plants.CreateModel
@{
    ViewData["Title"] = "Add Plant";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8 col-xl-6">
        <div class="mb-4">
            <a asp-page="./Index" class="text-decoration-none">
                ← Back to My Plants
            </a>
        </div>

        <h1>Add a plant</h1>

        <p class="text-muted mb-4">
            Add the basic information for a plant in your collection.
        </p>

        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label"></label>

                <input asp-for="Input.Name"
                       class="form-control"
                       placeholder="For example, Kitchen Monstera" />

                <span asp-validation-for="Input.Name"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Species" class="form-label"></label>

                <input asp-for="Input.Species"
                       class="form-control"
                       placeholder="For example, Monstera deliciosa" />

                <span asp-validation-for="Input.Species"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Location" class="form-label"></label>

                <input asp-for="Input.Location"
                       class="form-control"
                       placeholder="For example, Living room" />

                <span asp-validation-for="Input.Location"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.WateringIntervalDays"
                       class="form-label"></label>

                <div class="input-group">
                    <input asp-for="Input.WateringIntervalDays"
                           class="form-control"
                           min="1"
                           max="365" />

                    <span class="input-group-text">days</span>
                </div>

                <span asp-validation-for="Input.WateringIntervalDays"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Input.Notes" class="form-label"></label>

                <textarea asp-for="Input.Notes"
                          class="form-control"
                          rows="4"
                          placeholder="Light requirements, care notes or anything useful"></textarea>

                <span asp-validation-for="Input.Notes"
                      class="text-danger"></span>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success">
                    Add plant
                </button>

                <a asp-page="./Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}